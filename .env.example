# Hardware Acceleration Profile (Docker Compose)
# Options:
#   nvidia - Full GPU acceleration via NVIDIA CUDA (requires NVIDIA Container Toolkit / WSL2 GPU support)
#   rocm   - GPU acceleration via AMD ROCm (requires ROCm-compatible AMD GPU & drivers)
#   cpu    - Standard CPU execution with zero GPU driver dependencies
COMPOSE_PROFILES=cpu

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=rag
POSTGRES_PASSWORD=ragpassword
POSTGRES_DB=ragdb

# Qdrant
QDRANT_URL=http://localhost:6333

# Ollama / Embedding
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=bge-m3

# LLM / Chat
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2
